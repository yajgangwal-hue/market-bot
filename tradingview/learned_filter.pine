// Learned trade filter - exported from trade_learning.py
// status: USABLE_AS_VETO   out-of-sample AUC: 0.6192
// Trained in Python on 546 examples. Pine cannot fit this; it only
// evaluates the frozen weights below. Re-export after retraining.

winnerProbability() =>
    // score
    m_score = 50.9123626374
    s_score = 9.7855632713
    w_score = -0.0186637350
    // ma_separation
    m_ma_separation = 0.0282161218
    s_ma_separation = 0.0170931645
    w_ma_separation = 0.3486186675
    // extension_atr
    m_extension_atr = 1.7325972581
    s_extension_atr = 0.9476560247
    w_extension_atr = 0.0145318384
    // adx
    m_adx = 24.4376607664
    s_adx = 4.7933965466
    w_adx = -0.0479633261
    // rsi
    m_rsi = 64.8529074456
    s_rsi = 6.1348779826
    w_rsi = 0.0460337192
    // relative_volume
    m_relative_volume = 1.0039742571
    s_relative_volume = 0.3089814096
    w_relative_volume = 0.0891042375
    // atr_fraction
    m_atr_fraction = 0.0125583749
    s_atr_fraction = 0.0037164444
    w_atr_fraction = 0.3050930077
    // momentum
    m_momentum = 0.0118085935
    s_momentum = 0.0174681212
    w_momentum = 0.0032337182
    // trend_r_squared
    m_trend_r_squared = 0.6630047720
    s_trend_r_squared = 0.2394255949
    w_trend_r_squared = 0.0006111556
    // breakout_distance
    m_breakout_distance = -0.0077530581
    s_breakout_distance = 0.0100953076
    w_breakout_distance = -0.0889574873
    // volatility_percentile
    m_volatility_percentile = 0.2949709902
    s_volatility_percentile = 0.2551288748
    w_volatility_percentile = 0.1333190471
    b = -0.9960514380
    z = b
    // caller supplies each feature as f_<name>
    z := z + w_score * (f_score - m_score) / (s_score == 0 ? 1 : s_score)
    z := z + w_ma_separation * (f_ma_separation - m_ma_separation) / (s_ma_separation == 0 ? 1 : s_ma_separation)
    z := z + w_extension_atr * (f_extension_atr - m_extension_atr) / (s_extension_atr == 0 ? 1 : s_extension_atr)
    z := z + w_adx * (f_adx - m_adx) / (s_adx == 0 ? 1 : s_adx)
    z := z + w_rsi * (f_rsi - m_rsi) / (s_rsi == 0 ? 1 : s_rsi)
    z := z + w_relative_volume * (f_relative_volume - m_relative_volume) / (s_relative_volume == 0 ? 1 : s_relative_volume)
    z := z + w_atr_fraction * (f_atr_fraction - m_atr_fraction) / (s_atr_fraction == 0 ? 1 : s_atr_fraction)
    z := z + w_momentum * (f_momentum - m_momentum) / (s_momentum == 0 ? 1 : s_momentum)
    z := z + w_trend_r_squared * (f_trend_r_squared - m_trend_r_squared) / (s_trend_r_squared == 0 ? 1 : s_trend_r_squared)
    z := z + w_breakout_distance * (f_breakout_distance - m_breakout_distance) / (s_breakout_distance == 0 ? 1 : s_breakout_distance)
    z := z + w_volatility_percentile * (f_volatility_percentile - m_volatility_percentile) / (s_volatility_percentile == 0 ? 1 : s_volatility_percentile)
    1.0 / (1.0 + math.exp(-z))

// A probability below 0.25 is the veto band.
vetoThreshold = 0.2500
