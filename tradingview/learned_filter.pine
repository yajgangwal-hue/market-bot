// Learned trade filter - exported from trade_learning.py
// status: UNPROVEN   out-of-sample AUC: 0.542
// Trained in Python on 7452 examples. Pine cannot fit this; it only
// evaluates the frozen weights below. Re-export after retraining.

winnerProbability() =>
    // score
    m_score = 50.8478140097
    s_score = 11.2826947022
    w_score = 0.0005709180
    // ma_separation
    m_ma_separation = 0.0390757869
    s_ma_separation = 0.0286617540
    w_ma_separation = 0.0770452048
    // extension_atr
    m_extension_atr = 1.6666430470
    s_extension_atr = 0.9661726924
    w_extension_atr = 0.0130678608
    // adx
    m_adx = 27.4890276249
    s_adx = 7.5367277317
    w_adx = -0.0386669849
    // rsi
    m_rsi = 64.3363556225
    s_rsi = 6.2180266140
    w_rsi = 0.0160126926
    // relative_volume
    m_relative_volume = 0.9921555025
    s_relative_volume = 0.4032191040
    w_relative_volume = 0.0249135606
    // atr_fraction
    m_atr_fraction = 0.0184370237
    s_atr_fraction = 0.0077519214
    w_atr_fraction = 0.0797703095
    // momentum
    m_momentum = 0.0166928159
    s_momentum = 0.0280053911
    w_momentum = -0.0023418833
    // trend_r_squared
    m_trend_r_squared = 0.6193679062
    s_trend_r_squared = 0.2583176751
    w_trend_r_squared = 0.0008528525
    // breakout_distance
    m_breakout_distance = -0.0150939059
    s_breakout_distance = 0.0185606908
    w_breakout_distance = -0.0182045856
    // volatility_percentile
    m_volatility_percentile = 0.3987198997
    s_volatility_percentile = 0.2696442788
    w_volatility_percentile = 0.0208314749
    b = -1.0503153045
    z = b
    // caller supplies each feature as f_<name>
    z := z + w_score * (f_score - m_score) / (s_score == 0 ? 1 : s_score)
    z := z + w_ma_separation * (f_ma_separation - m_ma_separation) / (s_ma_separation == 0 ? 1 : s_ma_separation)
    z := z + w_extension_atr * (f_extension_atr - m_extension_atr) / (s_extension_atr == 0 ? 1 : s_extension_atr)
    z := z + w_adx * (f_adx - m_adx) / (s_adx == 0 ? 1 : s_adx)
    z := z + w_rsi * (f_rsi - m_rsi) / (s_rsi == 0 ? 1 : s_rsi)
    z := z + w_relative_volume * (f_relative_volume - m_relative_volume) / (s_relative_volume == 0 ? 1 : s_relative_volume)
    z := z + w_atr_fraction * (f_atr_fraction - m_atr_fraction) / (s_atr_fraction == 0 ? 1 : s_atr_fraction)
    z := z + w_momentum * (f_momentum - m_momentum) / (s_momentum == 0 ? 1 : s_momentum)
    z := z + w_trend_r_squared * (f_trend_r_squared - m_trend_r_squared) / (s_trend_r_squared == 0 ? 1 : s_trend_r_squared)
    z := z + w_breakout_distance * (f_breakout_distance - m_breakout_distance) / (s_breakout_distance == 0 ? 1 : s_breakout_distance)
    z := z + w_volatility_percentile * (f_volatility_percentile - m_volatility_percentile) / (s_volatility_percentile == 0 ? 1 : s_volatility_percentile)
    1.0 / (1.0 + math.exp(-z))

// A probability below 0.25 is the veto band.
vetoThreshold = 0.2500
