// Learned trade filter - exported from trade_learning.py
// status: UNPROVEN   out-of-sample AUC: 0.4857
// Trained in Python on 18497 examples. Pine cannot fit this; it only
// evaluates the frozen weights below. Re-export after retraining.

winnerProbability() =>
    // score
    m_score = 51.4405384657
    s_score = 11.4940219964
    w_score = -0.0066316317
    // ma_separation
    m_ma_separation = 0.0639522816
    s_ma_separation = 0.0589254796
    w_ma_separation = 0.0410599237
    // extension_atr
    m_extension_atr = 1.6806270499
    s_extension_atr = 0.9765470728
    w_extension_atr = 0.0047734464
    // adx
    m_adx = 29.3157136827
    s_adx = 9.1694333936
    w_adx = -0.0123413620
    // rsi
    m_rsi = 64.9700400240
    s_rsi = 6.6769630337
    w_rsi = 0.0164838594
    // relative_volume
    m_relative_volume = 0.9967001239
    s_relative_volume = 0.5171437955
    w_relative_volume = 0.0006369608
    // atr_fraction
    m_atr_fraction = 0.0272394440
    s_atr_fraction = 0.0162228378
    w_atr_fraction = 0.0465401208
    // momentum
    m_momentum = 0.0263980968
    s_momentum = 0.0480720661
    w_momentum = -0.0093187087
    // trend_r_squared
    m_trend_r_squared = 0.6365602615
    s_trend_r_squared = 0.2565806734
    w_trend_r_squared = 0.0016575868
    // breakout_distance
    m_breakout_distance = -0.0227231994
    s_breakout_distance = 0.0313876773
    w_breakout_distance = -0.0262649685
    // volatility_percentile
    m_volatility_percentile = 0.3794603676
    s_volatility_percentile = 0.2684574299
    w_volatility_percentile = -0.0162688829
    b = -0.9694104872
    z = b
    // caller supplies each feature as f_<name>
    z := z + w_score * (f_score - m_score) / (s_score == 0 ? 1 : s_score)
    z := z + w_ma_separation * (f_ma_separation - m_ma_separation) / (s_ma_separation == 0 ? 1 : s_ma_separation)
    z := z + w_extension_atr * (f_extension_atr - m_extension_atr) / (s_extension_atr == 0 ? 1 : s_extension_atr)
    z := z + w_adx * (f_adx - m_adx) / (s_adx == 0 ? 1 : s_adx)
    z := z + w_rsi * (f_rsi - m_rsi) / (s_rsi == 0 ? 1 : s_rsi)
    z := z + w_relative_volume * (f_relative_volume - m_relative_volume) / (s_relative_volume == 0 ? 1 : s_relative_volume)
    z := z + w_atr_fraction * (f_atr_fraction - m_atr_fraction) / (s_atr_fraction == 0 ? 1 : s_atr_fraction)
    z := z + w_momentum * (f_momentum - m_momentum) / (s_momentum == 0 ? 1 : s_momentum)
    z := z + w_trend_r_squared * (f_trend_r_squared - m_trend_r_squared) / (s_trend_r_squared == 0 ? 1 : s_trend_r_squared)
    z := z + w_breakout_distance * (f_breakout_distance - m_breakout_distance) / (s_breakout_distance == 0 ? 1 : s_breakout_distance)
    z := z + w_volatility_percentile * (f_volatility_percentile - m_volatility_percentile) / (s_volatility_percentile == 0 ? 1 : s_volatility_percentile)
    1.0 / (1.0 + math.exp(-z))

// A probability below 0.25 is the veto band.
vetoThreshold = 0.2500
